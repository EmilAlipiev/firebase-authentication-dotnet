<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>FirebaseAuthNet</PackageId>
    <PackageVersion>2.0.0</PackageVersion>
    <Authors>Emil Alipiev</Authors>
    <Description>Firebase authentication library. It can generate Firebase auth token based on given OAuth token (issued by Google, Facebook...). This Firebase token can then be used with REST queries against Firebase endpoints. </Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIconUrl></PackageIconUrl>
    <PackageProjectUrl>https://github.com/EmilAlipiev/firebase-authentication-dotnet</PackageProjectUrl>
    <PackageLicenseUrl>https://github.com/EmilAlipiev/firebase-authentication-dotnet?tab=MIT-1-ov-file</PackageLicenseUrl>
    <IncludeSource>True</IncludeSource>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Copyright></Copyright>
    <PackageTags>Firebase Auth Authentication Google Facebook Github Twitter</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Product>FirebaseAuthNet</Product>
    <RepositoryUrl>https://github.com/EmilAlipiev/firebase-authentication-dotnet</RepositoryUrl>
    <Version>2.0.0</Version>
    <PackageReleaseNotes>net6 and above support</PackageReleaseNotes>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="12.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>
